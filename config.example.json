{
  "mcpServers": {
    "zentao": {
      "command": "npx",
      "args": ["-y", "git+https://github.com/fragrans-maotou/zentao-mcp.git"],
      "env": {
        "ZENTAO_BASE": "http://your-zentao-host/zentao",
        "ZENTAO_ACCOUNT": "your_account",
        "ZENTAO_PASSWORD": "your_password"
      }
    }
  }
}
